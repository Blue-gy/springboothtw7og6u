@startuml 类图
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0

title 体育场馆管理系统 - 核心类图

' ==================== 实体类 ====================
package "实体层 (Entity)" #E3F2FD {
    class KechengxinxiEntity {
        - Long id
        - String kechengmingcheng
        - String kechengnandu
        - String shiherenqun
        - String kechengjianjie
        - String jiaolian
        - String kechengtupian
        - String shangkeshijian
        - String shangkedidian
        - Date clicktime
        - Integer discussnum
        - Integer storeupnum
        + get/set methods
    }
    
    class HuiyuanEntity {
        - Long id
        - String yonghuzhanghao
        - String xingming
        - String mima
        - String xingbie
        - String shouji
        - String touxiang
        + get/set methods
    }
    
    class OrdersEntity {
        - Long id
        - String orderid
        - Long userid
        - Long goodid
        - String goodname
        - Integer buynumber
        - Float price
        - Float total
        - String status
        + get/set methods
