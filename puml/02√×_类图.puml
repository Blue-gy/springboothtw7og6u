        - Long userid
        - String username
        - String token
        - Date expiratedtime
        + get/set methods
    }
}

' ==================== 控制器类 ====================
package "控制层 (Controller)" #C8E6C9 {
    class KechengxinxiController {
        + page(params): R
        + list(params): R
        + info(id): R
        + detail(id): R
        + save(entity): R
        + update(entity): R
        + delete(ids): R
        + autoSort(params): R
        + autoSort2(params): R
    }
    
    class HuiyuanController {
        + login(params): R
        + register(params): R
        + logout(): R
        + session(): R
        + resetPass(params): R
        + page(params): R
    }
    
    class OrdersController {
        + page(params): R
        + save(entity): R
        + update(entity): R
        + remind(column, type): R
        + value(x, y): R
        + group(column): R
    }
}

' ==================== 服务层 ====================
package "业务层 (Service)" #FFF9C4 {
    interface KechengxinxiService {
        + queryPage(params): PageUtils
        + selectListVO(wrapper): List
        + selectVO(wrapper): Object
    }
    
    class KechengxinxiServiceImpl {
    }
}

' ==================== DAO层 ====================
package "数据访问层 (DAO)" #FFCCBC {
    interface KechengxinxiDao {
        + selectListVO(wrapper): List
        + selectVO(wrapper): Object
    }
}

' ==================== 工具类 ====================
package "工具类 (Utils)" #E1BEE7 {
    class UserBasedCollaborativeFiltering {
        - Map userRatings
        - Map itemUsers
        - Long[][] sparseMatrix
        + calculateSimilarity(user1, user2): double
        + recommendItems(targetUser, num): List
    }
    
    class R {
        - int code
        - String msg
        + ok(): R
        + error(): R
    }
    
    class SQLFilter {
        + sqlInject(str): String
    }
    
    class EncryptUtil {
        + md5(text): String
        + sha256(text): String
        + aesEncrypt(text): String
    }
    
    class BaiduUtil {
        + getCityByLonLat(key, lng, lat): String
        + generalString(imagePath): String
    }
}

' ==================== 配置类 ====================
package "配置类 (Config)" #B2DFDB {
    class InterceptorConfig {
        + getAuthorizationInterceptor()
        + addInterceptors(registry)
    }
    
    class AuthorizationInterceptor {
        + preHandle(request, response, handler): boolean
    }
}

' ==================== 关系 ====================
KechengxinxiServiceImpl ..|> KechengxinxiService
KechengxinxiDao --|> BaseMapper

KechengxinxiController --> KechengxinxiService
KechengxinxiServiceImpl --> KechengxinxiDao
KechengxinxiController --> R
KechengxinxiController --> UserBasedCollaborativeFiltering
KechengxinxiController --> SQLFilter
HuiyuanController --> EncryptUtil
InterceptorConfig --> AuthorizationInterceptor

@enduml
