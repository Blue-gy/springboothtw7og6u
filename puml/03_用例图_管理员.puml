@startuml 管理员用例图
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 12

title 体育场馆管理系统 - 管理员用例图

left to right direction

actor "管理员" as Admin

rectangle "体育场馆管理系统" {
    
    package "系统管理" {
        usecase "管理员登录" as UC1
        usecase "会员管理" as UC2
        usecase "员工管理" as UC3
        usecase "系统配置" as UC4
    }
    
    package "场地管理" {
        usecase "场地信息增删改查" as UC5
        usecase "场地预约审核" as UC6
        usecase "场地维修管理" as UC7
    }
    
    package "课程管理" {
        usecase "课程信息增删改查" as UC8
        usecase "课程预约审核" as UC9
    }
    
    package "赛事活动管理" {
        usecase "比赛信息管理" as UC10
        usecase "比赛报名审核" as UC11
        usecase "活动信息管理" as UC12
        usecase "活动报名审核" as UC13
    }
    
    package "设备管理" {
        usecase "设备信息增删改查" as UC14
        usecase "设备租赁审核" as UC15
        usecase "设备维修管理" as UC16
    }
    
    package "商城管理" {
        usecase "商品分类管理" as UC17
        usecase "商品信息管理" as UC18
        usecase "订单管理" as UC19
        usecase "订单统计" as UC20
    }
    
    package "内容管理" {
        usecase "公告发布管理" as UC21
        usecase "留言回复" as UC22
        usecase "评论管理" as UC23
    }
    
    package "财务管理" {
        usecase "财务数据统计" as UC24
        usecase "财务报表查看" as UC25
        usecase "收入分析" as UC26
    }
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC9
Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15
Admin --> UC16
Admin --> UC17
Admin --> UC18
Admin --> UC19
Admin --> UC20
Admin --> UC21
Admin --> UC22
Admin --> UC23
Admin --> UC24
Admin --> UC25
Admin --> UC26

@enduml
