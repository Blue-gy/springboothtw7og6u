@startuml ER图
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 10

title 体育场馆管理系统 - 数据库ER图

' ==================== 用户相关表 ====================
entity "users\n管理员表" as Users {
    * id: BIGINT <<PK>>
    --
    * username: VARCHAR
    * password: VARCHAR
    * role: VARCHAR
    image: VARCHAR
    addtime: DATETIME
}

entity "huiyuan\n会员表" as Huiyuan {
    * id: BIGINT <<PK>>
    --
    * yonghuzhanghao: VARCHAR
    * xingming: VARCHAR
    * mima: VARCHAR
    xingbie: VARCHAR
    shouji: VARCHAR
    touxiang: VARCHAR
    addtime: DATETIME
}

entity "yuangong\n员工表" as Yuangong {
    * id: BIGINT <<PK>>
    --
    * yuangongzhanghao: VARCHAR
    * yuangongxingming: VARCHAR
    * mima: VARCHAR
    xingbie: VARCHAR
    lianxidianhua: VARCHAR
    touxiang: VARCHAR
    addtime: DATETIME
}

entity "token\nToken认证表" as Token {
    * id: BIGINT <<PK>>
    --
    * userid: BIGINT <<FK>>
    * username: VARCHAR
    tablename: VARCHAR
    role: VARCHAR
    * token: VARCHAR
    addtime: DATETIME
    expiratedtime: DATETIME
}

' ==================== 场地相关表 ====================
entity "changdixinxi\n场地信息表" as Changdixinxi {
    * id: BIGINT <<PK>>
    --
    * changdimingcheng: VARCHAR
    changditupian: VARCHAR
    changdijieshao: TEXT
    changdidizhi: VARCHAR
    changdisheshi: VARCHAR
    kaifangshijian: VARCHAR
    changdijiage: DECIMAL
    discussnum: INT
    storeupnum: INT
    addtime: DATETIME
}

entity "changdiyuyue\n场地预约表" as Changdiyuyue {
    * id: BIGINT <<PK>>
    --
    * changdimingcheng: VARCHAR
    changditupian: VARCHAR
    shijianduan: VARCHAR
    yuyueshijian: DATETIME
    yonghuzhanghao: VARCHAR <<FK>>
    xingming: VARCHAR
    shouji: VARCHAR
    sfsh: VARCHAR
    shhf: TEXT
    addtime: DATETIME
}

entity "changdiweixiu\n场地维修表" as Changdiweixiu {
    * id: BIGINT <<PK>>
    --
    * changdimingcheng: VARCHAR
    weixiuneirong: TEXT
    yuangongzhanghao: VARCHAR <<FK>>
    yuangongxingming: VARCHAR
    weixiushijian: DATETIME
    weixiuzhuangtai: VARCHAR
    addtime: DATETIME
}

' ==================== 课程相关表 ====================
entity "kechengxinxi\n课程信息表" as Kechengxinxi {
    * id: BIGINT <<PK>>
    --
    * kechengmingcheng: VARCHAR
    kechengnandu: VARCHAR
    shiherenqun: VARCHAR
    kechengjianjie: TEXT
    jiaolian: VARCHAR
    kechengtupian: VARCHAR
    shangkeshijian: VARCHAR
    shangkedidian: VARCHAR
    clicktime: DATETIME
    discussnum: INT
    storeupnum: INT
    addtime: DATETIME
}

entity "kechengyuyue\n课程预约表" as Kechengyuyue {
    * id: BIGINT <<PK>>
    --
    * kechengmingcheng: VARCHAR
    jiaolian: VARCHAR
    shangkeshijian: VARCHAR
    yuyueshijian: DATETIME
    yonghuzhanghao: VARCHAR <<FK>>
    xingming: VARCHAR
    sfsh: VARCHAR
    shhf: TEXT
    addtime: DATETIME
}

' ==================== 设备相关表 ====================
entity "shebeizulin\n设备租赁表" as Shebeizulin {
    * id: BIGINT <<PK>>
    --
    * shebeimingcheng: VARCHAR
    kucunshuliang: INT
    shebeitupian: VARCHAR
    shebeijianjie: TEXT
    zulinjiage: DECIMAL
    discussnum: INT
    storeupnum: INT
    addtime: DATETIME
}

entity "zulinjilu\n租赁记录表" as Zulinjilu {
    * id: BIGINT <<PK>>
    --
    * shebeimingcheng: VARCHAR
    kucunshuliang: INT
    zulinjiage: DECIMAL
    zulinjine: DECIMAL
    zulinshijian: DATETIME
    yonghuzhanghao: VARCHAR <<FK>>
    xingming: VARCHAR
    sfsh: VARCHAR
    addtime: DATETIME
}

entity "zulinguihai\n租赁归还表" as Zulinguihai {
    * id: BIGINT <<PK>>
    --
    * shebeimingcheng: VARCHAR
    kucunshuliang: INT
    zulinjine: DECIMAL
    yonghuzhanghao: VARCHAR <<FK>>
    xingming: VARCHAR
    guihaishijian: DATETIME
    sfsh: VARCHAR
    addtime: DATETIME
}

' ==================== 赛事活动表 ====================
entity "bisai\n比赛表" as Bisai {
    * id: BIGINT <<PK>>
    --
    * saishimingcheng: VARCHAR
    bisaishijian: DATETIME
    bisaididian: VARCHAR
    bisaitupian: VARCHAR
    fabushijian: DATETIME
    discussnum: INT
    storeupnum: INT
    addtime: DATETIME
}

entity "bisaibaoming\n比赛报名表" as Bisaibaoming {
    * id: BIGINT <<PK>>
    --
    * saishimingcheng: VARCHAR
    bisaishijian: DATETIME
    bisaididian: VARCHAR
    baomingshijian: DATETIME
    yonghuzhanghao: VARCHAR <<FK>>
    xingming: VARCHAR
    sfsh: VARCHAR
    addtime: DATETIME
}

entity "huodongxinxi\n活动信息表" as Huodongxinxi {
    * id: BIGINT <<PK>>
    --
    * huodongmingcheng: VARCHAR
    huodongshijian: DATETIME
    huodongdidian: VARCHAR
    huodongtupian: VARCHAR
    fabushijian: DATETIME
    discussnum: INT
    storeupnum: INT
    addtime: DATETIME
}

entity "baominghuodong\n报名活动表" as Baominghuodong {
    * id: BIGINT <<PK>>
    --
    * huodongmingcheng: VARCHAR
    huodongshijian: DATETIME
    baomingshijian: DATETIME
    yonghuzhanghao: VARCHAR <<FK>>
    xingming: VARCHAR
    sfsh: VARCHAR
    addtime: DATETIME
}

' ==================== 商城相关表 ====================
entity "shangpinfenlei\n商品分类表" as Shangpinfenlei {
    * id: BIGINT <<PK>>
    --
    * shangpinfenlei: VARCHAR
    addtime: DATETIME
}

entity "shangpinxinxi\n商品信息表" as Shangpinxinxi {
    * id: BIGINT <<PK>>
    --
    * shangpinmingcheng: VARCHAR
    shangpinfenlei: VARCHAR <<FK>>
    shangpintupian: VARCHAR
    shangpinguige: VARCHAR
    pinpai: VARCHAR
    alllimittimes: INT
    price: DECIMAL
    addtime: DATETIME
}

entity "cart\n购物车表" as Cart {
    * id: BIGINT <<PK>>
    --
    tablename: VARCHAR
    userid: BIGINT <<FK>>
    goodid: BIGINT
    goodname: VARCHAR
    buynumber: INT
    price: DECIMAL
    discountprice: DECIMAL
    addtime: DATETIME
}

entity "orders\n订单表" as Orders {
    * id: BIGINT <<PK>>
    --
    * orderid: VARCHAR
    tablename: VARCHAR
    userid: BIGINT <<FK>>
    goodid: BIGINT
    goodname: VARCHAR
    buynumber: INT
    price: DECIMAL
    total: DECIMAL
    type: INT
    status: VARCHAR
    address: VARCHAR
    tel: VARCHAR
    consignee: VARCHAR
    logistics: VARCHAR
    addtime: DATETIME
}

' ==================== 互动功能表 ====================
entity "storeup\n收藏表" as Storeup {
    * id: BIGINT <<PK>>
    --
    userid: BIGINT <<FK>>
    refid: BIGINT
    tablename: VARCHAR
    name: VARCHAR
    picture: VARCHAR
    type: VARCHAR
    addtime: DATETIME
}

entity "messages\n留言表" as Messages {
    * id: BIGINT <<PK>>
    --
    userid: BIGINT <<FK>>
    username: VARCHAR
    avatarurl: VARCHAR
    content: TEXT
    cpicture: VARCHAR
    reply: TEXT
    addtime: DATETIME
}

entity "news\n公告表" as News {
    * id: BIGINT <<PK>>
    --
    * title: VARCHAR
    introduction: TEXT
    typename: VARCHAR
    name: VARCHAR
    clicknum: INT
    clicktime: DATETIME
    thumbsupnum: INT
    storeupnum: INT
    picture: VARCHAR
    content: TEXT
    addtime: DATETIME
}

' ==================== 财务管理表 ====================
entity "caiwuqingkuang\n财务情况表" as Caiwu {
    * id: BIGINT <<PK>>
    --
    * tongjiriqi: DATE
    huiyuanxiaofei: DECIMAL
    changdizulinfeiyong: DECIMAL
    huodongshouru: DECIMAL
    zongshouru: DECIMAL
    addtime: DATETIME
}

' ==================== 关系定义 ====================
Huiyuan ||--o{ Changdiyuyue : "预约"
Huiyuan ||--o{ Kechengyuyue : "预约"
Huiyuan ||--o{ Bisaibaoming : "报名"
Huiyuan ||--o{ Baominghuodong : "报名"
Huiyuan ||--o{ Zulinjilu : "租赁"
Huiyuan ||--o{ Zulinguihai : "归还"
Huiyuan ||--o{ Cart : "购物车"
Huiyuan ||--o{ Orders : "订单"
Huiyuan ||--o{ Storeup : "收藏"
Huiyuan ||--o{ Messages : "留言"

Yuangong ||--o{ Changdiweixiu : "维修"

Changdixinxi ||--o{ Changdiyuyue : "被预约"
Changdixinxi ||--o{ Changdiweixiu : "被维修"

Kechengxinxi ||--o{ Kechengyuyue : "被预约"

Shebeizulin ||--o{ Zulinjilu : "被租赁"
Shebeizulin ||--o{ Zulinguihai : "被归还"

Bisai ||--o{ Bisaibaoming : "被报名"
Huodongxinxi ||--o{ Baominghuodong : "被报名"

Shangpinfenlei ||--o{ Shangpinxinxi : "包含"

Shangpinxinxi ||--o{ Cart : "被加入购物车"
Shangpinxinxi ||--o{ Orders : "被购买"

Users ||--o{ Token : "生成"
Huiyuan ||--o{ Token : "生成"
Yuangong ||--o{ Token : "生成"

@enduml
