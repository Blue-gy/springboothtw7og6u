@startuml 用户登录时序图
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 11

title 体育场馆管理系统 - 用户登录时序图

actor "用户" as User
participant "前端Vue" as Front
participant "HuiyuanController" as Controller
participant "TokenService" as TokenService
participant "HuiyuanService" as Service
participant "MySQL" as DB

User -> Front: 输入账号密码
Front -> Controller: POST /huiyuan/login
activate Controller

Controller -> Service: 查询用户信息
activate Service
Service -> DB: SELECT * FROM huiyuan
activate DB
DB --> Service: 返回用户数据
deactivate DB
Service --> Controller: 用户实体

alt 用户存在且密码正确
    Controller -> TokenService: 生成Token
    activate TokenService
    TokenService -> DB: INSERT INTO token
    TokenService --> Controller: Token对象
    deactivate TokenService
    Controller --> Front: 登录成功 + Token
else 登录失败
    Controller --> Front: 账号或密码错误
end
deactivate Service
deactivate Controller

Front --> User: 显示结果

@enduml
