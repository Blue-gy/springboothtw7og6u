@startuml 会员业务流程图
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 11

title 体育场馆管理系统 - 用户业务流程图

|用户|
start
:注册/登录系统;

switch (选择功能模块)
case (场地服务)
  :浏览场地列表;
  :选择场地和时间段;
  :提交预约申请;
  |系统|
  :创建预约记录;
  :等待管理员审核;
  |管理员|
  :审核预约;
  |系统|
  if (审核通过?) then (是)
    |用户|
    :预约成功;
  else (否)
    |用户|
    :收到拒绝通知;
  endif

case (课程服务)
  :浏览课程列表;
  :查看推荐课程\n(协同过滤算法);
  :选择课程;
  :提交预约申请;
  |系统|
  :创建预约记录;
  :等待审核;
  |管理员|
  :审核预约;
  |系统|
  if (审核通过?) then (是)
    |用户|
    :预约成功;
  else (否)
    |用户|
    :收到拒绝通知;
  endif

case (赛事活动)
  :浏览比赛/活动列表;
  :选择比赛/活动;
  :提交报名申请;
  |系统|
  :创建报名记录;
  :等待审核;
  |管理员|
  :审核报名;
  |系统|
  if (审核通过?) then (是)
    |用户|
    :报名成功;
  else (否)
    |用户|
    :收到拒绝通知;
  endif

case (设备租赁)
  :浏览设备列表;
  :选择设备和数量;
  :提交租赁申请;
  |系统|
  :检查库存;
  :创建租赁记录;
  :等待审核;
  |管理员|
  :审核租赁;
  |系统|
  if (审核通过?) then (是)
    |用户|
    :领取设备;
    :使用设备;
    :归还设备;
    |系统|
    :检查设备状态;
    :完成归还;
  else (否)
    |用户|
    :收到拒绝通知;
  endif

case (商城购物)
  :浏览商品;
  :加入购物车;
  :确认订单;
  |系统|
  :生成订单;
  :计算总价;
  |用户|
  :支付订单;
  |系统|
  :更新订单状态;
  |管理员|
  :发货;
  |用户|
  :确认收货;
  :评价商品;

endswitch
stop

@enduml
