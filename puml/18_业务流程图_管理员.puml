@startuml 管理员业务流程图
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 11

title 体育场馆管理系统 - 管理员业务流程图

|管理员|
start
:管理员登录;

switch (选择管理功能)
case (预约审核管理)
  :查看待审核列表;
  
  switch (审核类型)
  case (场地预约审核)
    :查看场地预约详情;
    :确认场地可用性;
    if (通过审核?) then (是)
      |系统|
      :更新状态为已通过;
    else (否)
      |系统|
      :填写拒绝原因;
      :更新状态为已拒绝;
    endif
    
  case (课程预约审核)
    :查看课程预约详情;
    :确认课程容量;
    if (通过审核?) then (是)
      |系统|
      :更新状态为已通过;
      :减少课程容量;
    else (否)
      |系统|
      :更新状态为已拒绝;
    endif
    
  case (比赛/活动报名审核)
    :查看报名详情;
    if (通过审核?) then (是)
      |系统|
      :更新状态为已通过;
    else (否)
      |系统|
      :更新状态为已拒绝;
    endif
    
  case (设备租赁审核)
    :查看租赁申请详情;
    :确认库存充足;
    if (通过审核?) then (是)
      |系统|
      :更新状态为已通过;
      :减少库存;
    else (否)
      |系统|
      :更新状态为已拒绝;
    endif
  endswitch

case (信息管理)
  :选择管理模块;
  
  switch (模块类型)
  case (场地/课程/设备)
    :添加新信息;
    :编辑已有信息;
    :删除信息;
    
  case (商品管理)
    :管理商品分类;
    :添加/编辑商品;
    :管理库存;
    
  case (公告管理)
    :发布新公告;
    :编辑公告;
    :删除公告;
  endswitch

case (财务管理)
  :查看财务统计;
  :查看收入分析;
  :导出财务报表;

case (用户管理)
  :管理会员信息;
  :管理员工信息;
  :分配维修任务;
endswitch
stop

@enduml
