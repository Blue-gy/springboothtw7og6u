@startuml 员工业务流程图
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 11

title 体育场馆管理系统 - 员工业务流程图

|员工|
start
:员工登录系统;

switch (选择功能)
case (场地维修)
  :查看场地维修任务列表;
  :选择维修任务;
  :查看维修详情;
  :执行维修工作;
  :提交维修记录;
  |系统|
  :保存维修记录;
  :更新维修状态;
  if (维修完成?) then (是)
    :标记为已完成;
  else (否)
    :标记为维修中;
    :继续维修;
  endif

case (设备维修)
  :查看设备维修任务列表;
  :选择维修任务;
  :查看维修详情;
  :执行维修工作;
  :提交维修记录;
  |系统|
  :保存维修记录;
  :更新维修状态;
  if (维修完成?) then (是)
    :标记为已完成;
  else (否)
    :标记为维修中;
    :继续维修;
  endif

case (信息查看)
  :查看场地信息;
  :查看设备信息;
  :查看课程安排;
  :查看公告通知;

case (个人管理)
  :修改个人信息;
  :修改密码;
endswitch
stop

@enduml
