@startuml 三层架构图
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13

title 体育场馆管理系统 - 三层架构图

' ==================== 表示层 ====================
package "表示层 (Presentation Layer)" #E3F2FD {
    [管理后台\nVue 2 + Element UI\n端口: 8081] as AdminWeb
    [用户前端\nVue 2 + Element UI\n端口: 8082] as UserWeb
    [Axios\nHTTP请求] as Axios
}

' ==================== 业务逻辑层 ====================
package "业务逻辑层 (Business Logic Layer)" #E8F5E9 {
    [Spring Boot\nController层\n24个Controller] as Controller
    
    package "Service服务层" #C8E6C9 {
        [场地服务] as CDService
        [课程服务] as KCService
        [订单服务] as OrderService
        [用户服务] as UserService
        [推荐算法\n协同过滤] as CFService
    }
    
    package "工具组件" #FFF9C4 {
        [Token认证\n拦截器] as Auth
        [加密工具\nMD5/AES] as Encrypt
        [SQL注入防护] as SQLFilter
        [百度AI集成] as BaiduAI
    }
}

' ==================== 数据库层 ====================
package "数据库层 (Data Access Layer)" #FFEBEE {
    [MyBatis-Plus\nORM框架] as MyBatisPlus
    [MySQL 5.7\n25张表] as MySQL
}

' ==================== 连接关系 ====================
AdminWeb --> Axios
UserWeb --> Axios
Axios --> Controller

Controller --> CDService
Controller --> KCService
Controller --> OrderService
Controller --> UserService
Controller --> CFService

Controller --> Auth
Controller --> Encrypt
Controller --> SQLFilter

CDService --> MyBatisPlus
KCService --> MyBatisPlus
OrderService --> MyBatisPlus
UserService --> MyBatisPlus
CFService --> MyBatisPlus

MyBatisPlus --> MySQL

@enduml
