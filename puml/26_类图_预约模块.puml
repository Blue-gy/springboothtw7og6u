    - String shhf
    + get/set methods
}

class ChangdiyuyueController {
    + page(params): R
    + list(params): R
    + save(entity): R
    + update(entity): R
    + delete(ids): R
    + shBatch(ids, sfsh, shhf): R
}

interface ChangdiyuyueService {
    + queryPage(params): PageUtils
