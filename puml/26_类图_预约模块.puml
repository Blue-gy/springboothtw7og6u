}

class KechengyuyueEntity {
    - Long id
    - String kechengmingcheng
    - String yonghuzhanghao
    - Date yuyueshijian
    - String sfsh
    + get/set methods
}

class KechengyuyueController {
    + page(params): R
    + save(entity): R
